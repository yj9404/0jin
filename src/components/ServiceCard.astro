---
/**
 * 홈 서비스 카드. 카드는 항상 상세 페이지(/projects/<slug>/)로 간다.
 * 크기(span)별 커버 구성은 ServiceCover, 메타 줄 규칙은 src/lib/card.ts.
 */
import type { Service } from '../data/services';
import { metaLinks, metaText, projectPath } from '../lib/card';
import ServiceCover from './ServiceCover.astro';

interface Props {
  service: Service;
  span: 1 | 2 | 3;
  row: number;
  column: number;
}

const { service, span, row, column } = Astro.props;
const links = metaLinks(service);
---
<article
  class:list={['card', `span-${span}`]}
  style={`grid-row: ${row}; grid-column: ${column} / span ${span};`}
>
  <ServiceCover service={service} size={span} />

  <div class="caption">
    <span class="text">
      <h3 class="name"><a class="card-link" href={projectPath(service.slug)}>{service.name}</a></h3>
      <span class="tagline">{service.tagline}</span>
    </span>
    <span class="meta">
      {metaText(service).join(' · ')}
      {links.map((l) => (<> · <a href={l.href}>{l.label}</a></>))}
    </span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  /* 화면이 올라오는 효과. 모든 카드가 상세 페이지로 링크된다 */
  .card:hover :global(.screen),
  .card:focus-within :global(.screen) {
    transform: translateY(-14px);
  }
  .card:has(.card-link:focus-visible) :global(.cover) {
    outline: 2px solid var(--fg);
    outline-offset: 6px;
  }

  .caption { display: flex; flex-direction: column; gap: 4px; }
  .span-3 .caption,
  .span-2 .caption {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .text { display: flex; flex-direction: column; gap: 4px; }
  .name { margin: 0; font-size: 18px; font-weight: 700; }
  .span-3 .name { font-size: 20px; }
  .card-link { color: inherit; text-decoration: none; }
  /* 카드 전체를 덮는 링크. 메타 줄의 링크는 그 위에 올린다 */
  .card-link::after { content: ''; position: absolute; inset: 0; }
  .card-link:focus-visible { outline: none; }
  .tagline { font-size: 15px; color: var(--fg-sub); }
  .meta {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-muted);
    padding-top: 6px;
  }
  .span-3 .meta,
  .span-2 .meta { padding-top: 0; }
  .meta a { position: relative; z-index: 1; color: var(--fg-muted); }
  .meta a:hover { color: var(--fg); }

  @media (max-width: 820px) {
    .card { grid-row: auto !important; grid-column: auto !important; }
  }
</style>
