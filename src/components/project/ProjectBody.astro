---
/** 상세 본문(MDX) 글자 폭과 타이포그래피. 본문 요소는 MDX가 만들므로 :global로 스타일한다. */
---
<article class="prose">
  <slot />
</article>

<style>
  .prose {
    max-width: 680px;
    font-size: 17px;
    line-height: 1.8;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .prose :global(h2) {
    margin: 56px 0 12px;
    font-size: 21px;
    line-height: 1.4;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { margin: 32px 0 8px; font-size: 18px; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 16px; padding-left: 22px; }
  .prose :global(li) { margin: 6px 0; }
  .prose :global(li::marker) { color: var(--fg-muted); }
  .prose :global(strong) { font-weight: 700; color: #ffffff; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 2px 6px;
    border-radius: 4px;
    background: #1d1d1d;
  }
  .prose :global(pre) {
    margin: 0 0 16px;
    padding: 16px;
    border-radius: 8px;
    background: #1a1a1a;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose :global(pre code) { padding: 0; background: none; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 15px; }
  .prose :global(th),
  .prose :global(td) { padding: 8px 10px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .prose :global(blockquote) {
    margin: 0 0 16px;
    padding-left: 16px;
    border-left: 2px solid var(--line);
    color: var(--fg-sub);
  }

  @media (max-width: 820px) {
    .prose { font-size: 16px; }
    .prose :global(h2) { margin-top: 44px; font-size: 19px; }
  }
</style>
