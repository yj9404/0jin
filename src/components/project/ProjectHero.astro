---
/** 상세 페이지 윗부분: 커버, 제목, 한 줄 설명, 메타 줄, 링크 버튼 */
import type { Service } from '../../data/services';
import { metaText, periodText, visibleLinks } from '../../lib/card';
import ServiceCover from '../ServiceCover.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const links = visibleLinks(service);
---
<section class="hero" aria-labelledby="project-title">
  <ServiceCover service={service} size={3} />

  <div class="head">
    <h1 id="project-title" class="name">{service.name}</h1>
    <p class="tagline">{service.tagline}</p>
    <p class="meta">{metaText(service).join(' · ')}</p>
  </div>

  {(service.status === 'archived' || links.length > 0) && (
    <div class="actions">
      {service.status === 'archived' && <p class="ended">운영 종료 ({periodText(service)})</p>}
      {links.length > 0 && (
        <ul class="links">
          {links.map((l, i) => (
            <li><a class:list={['button', { primary: i === 0 && l.kind !== 'github' }]} href={l.href}>{l.label} ↗</a></li>
          ))}
        </ul>
      )}
    </div>
  )}
</section>

<style>
  .hero { display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 8px; }
  .name { margin: 0; font-size: 32px; line-height: 1.3; font-weight: 700; word-break: keep-all; }
  .tagline { margin: 0; font-size: 18px; color: var(--fg-sub); word-break: keep-all; }
  .meta { margin: 4px 0 0; font-family: var(--font-mono); font-size: 13px; color: var(--fg-muted); }

  .actions { display: flex; flex-direction: column; gap: 12px; }
  .ended { margin: 0; font-size: 15px; color: var(--fg-sub); }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    box-sizing: border-box;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 14px;
    text-decoration: none;
  }
  .button:hover { border-color: var(--fg-muted); }
  .primary { background: var(--fg); border-color: var(--fg); color: var(--bg); }
  .primary:hover { background: #ffffff; border-color: #ffffff; }

  @media (max-width: 820px) {
    .hero { gap: 24px; }
    .name { font-size: 26px; }
    .tagline { font-size: 16px; }
  }
</style>
