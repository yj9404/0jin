---
/**
 * 서비스 커버(배경색 + 폰 화면). 홈 카드와 상세 페이지가 같이 쓴다.
 *   size 3 — 넓은 커버: 왼쪽 큰 제목, 오른쪽 화면 (홈 span 3, 상세 페이지)
 *   size 2 — size 3을 줄인 중간형
 *   size 1 — 가운데 화면만
 * transition:name이 같아 홈 카드 ↔ 상세 페이지 사이에서 커버가 이어진다(View Transitions).
 */
import { Image } from 'astro:assets';
import type { Service } from '../data/services';
import { inkFor } from '../lib/card';
import { mockups } from './screens';

interface Props {
  service: Service;
  size: 1 | 2 | 3;
}

const { service, size } = Astro.props;
const wide = size > 1;
const ink = service.ink ?? inkFor(service.color);
const coverLines = (service.coverTitle ?? service.name).split('\n');
const screen = service.screen;
const Mockup = screen.type === 'mockup' ? mockups[screen.name] : null;
---
<div
  class:list={['cover', `size-${size}`, `is-${service.status}`]}
  style={`--card-bg: ${service.color}; --card-ink: ${ink};`}
  transition:name={`cover-${service.slug}`}
>
  <div class="art">
    {wide && (
      <span class="title" aria-hidden="true">
        {coverLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
      </span>
    )}
    <div class="screen">
      {Mockup && <Mockup />}
      {screen.type === 'image' &&
        (typeof screen.src === 'string'
          ? <img src={screen.src} alt={screen.alt} loading="lazy" decoding="async" />
          : <Image src={screen.src} alt={screen.alt} widths={[380, 760]} sizes="380px" />)}
    </div>
  </div>
  {service.status === 'wip' && <span class="badge">만드는 중</span>}
</div>

<style>
  .cover {
    position: relative;
    height: 420px;
    border-radius: 10px;
    overflow: hidden;
  }
  .size-3 { height: 540px; }

  .art {
    height: 100%;
    background: var(--card-bg);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 32px;
    box-sizing: border-box;
  }
  .is-archived .art { filter: grayscale(1); }
  .size-3 .art { justify-content: space-between; gap: 48px; padding: 0 64px; }
  .size-2 .art { justify-content: space-between; gap: 32px; padding: 0 40px; }

  .title {
    align-self: center;
    font-family: 'Gowun Dodum', sans-serif;
    font-size: 52px;
    line-height: 1.3;
    color: var(--card-ink);
    max-width: 460px;
    word-break: keep-all;
  }
  .size-2 .title { font-size: 36px; max-width: 300px; }

  /* 폰 화면 */
  .screen {
    width: 100%;
    height: 340px;
    border-radius: 22px 22px 0 0;
    overflow: hidden;
    background: #ffffff;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .size-3 .screen {
    width: 380px;
    height: 460px;
    flex-shrink: 1;
    border-radius: 28px 28px 0 0;
    margin-left: auto;
  }
  .size-2 .screen { width: 320px; flex-shrink: 1; margin-left: auto; }
  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  /* 만드는 중 표시: 서비스와 상관없이 홈 공통 스타일 */
  .badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.82);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  @media (max-width: 820px) {
    .size-3 { height: 420px; }
    .size-3 .art,
    .size-2 .art { justify-content: center; padding: 0 32px; }
    .title { display: none; }
    .size-3 .screen,
    .size-2 .screen {
      width: 100%;
      max-width: 380px;
      height: 340px;
      margin: 0 auto;
      border-radius: 22px 22px 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen { transition: none; }
  }
</style>
