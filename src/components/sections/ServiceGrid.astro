---
/** 서비스 그리드. 무엇을 어디에 둘지는 src/data/layout.ts 에서만 정한다. */
import ServiceCard from '../ServiceCard.astro';
import { layout } from '../../data/layout';
import { services } from '../../data/services';
import { placeCards } from '../../lib/grid';

const cards = placeCards(layout, services);
---
<section aria-label="만든 것들" class="grid">
  {cards.map((c) => <ServiceCard service={c.service} span={c.span} row={c.row} column={c.column} />)}
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 56px;
  }
  @media (max-width: 820px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
